# Database
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/omni_player

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Streaming
MAX_BUFFER_SIZE=8192
BUFFER_TIMEOUT=30
FFMPEG_PATH=ffmpeg

# HLS
HLS_ENABLED=true
HLS_SEGMENT_DURATION=6
HLS_USE_S3=false

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173